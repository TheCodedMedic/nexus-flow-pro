{
   "action": {
      "default_icon": {
         "128": "icons/icon-128.png",
         "16": "icons/icon-16.png",
         "32": "icons/icon-32.png",
         "48": "icons/icon-48.png"
      },
      "default_title": "Nexus Flow Pro"
   },
   "background": {
      "service_worker": "background/service-worker.js"
   },
   "content_scripts": [
      {
         "js": [
            "selectors.js",
            "content.js"
         ],
         "matches": [
            "https://labs.google/fx/*",
            "https://flow.google.com/*"
         ],
         "run_at": "document_idle"
      }
   ],
   "description": "Bulk image generation for Google Flow with character references and auto-save to your computer or Google Drive.",
   "host_permissions": [
      "https://labs.google/fx/*",
      "https://flow.google.com/*",
      "https://script.google.com/*",
      "https://script.googleusercontent.com/*"
   ],
   "icons": {
      "128": "icons/icon-128.png",
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
   },
   "manifest_version": 3,
   "minimum_chrome_version": "114",
   "name": "Nexus Flow Pro",
   "permissions": [
      "storage",
      "sidePanel",
      "unlimitedStorage",
      "scripting",
      "downloads",
      "debugger"
   ],
   "side_panel": {
      "default_path": "sidepanel/sidepanel.html"
   },
   "version": "1.1.4",
   "key": ""
}
